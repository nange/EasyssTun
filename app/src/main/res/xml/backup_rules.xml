<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for devices before Android 12.

   Server profiles store the proxy password in plain text in the default
   SharedPreferences, so the whole sharedpref domain is excluded from backup
   instead of letting a cloud backup or a device transfer carry credentials.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
</full-backup-content>
