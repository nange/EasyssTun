<?xml version="1.0" encoding="utf-8"?><!--
   Android 12+ 的备份与换机迁移规则：配置档密码以明文存在默认 SharedPreferences，
   sharedpref 域在云备份和设备间迁移中都排除。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
