<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12+.

   Server profiles store the proxy password in plain text in the default
   SharedPreferences, so the sharedpref domain is excluded from both cloud
   backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
