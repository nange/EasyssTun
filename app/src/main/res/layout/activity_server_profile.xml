<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ServerProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Section: Basic -->
        <com.google.android.material.card.MaterialCardView
            style="@style/mCard">

            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/section_basic" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/hint_name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/profile_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/hint_server_host">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/profile_server"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/hint_server_port">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/profile_server_port"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="@string/default_server_port" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:hint="@string/hint_password"
                        app:passwordToggleEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/profile_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/hint_socks_port">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/profile_socks_port"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="@string/default_socks_port" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section: Protocol Settings -->
        <com.google.android.material.card.MaterialCardView
            style="@style/mCard"
            android:layout_marginTop="10dp">

            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/section_protocol_settings" />

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_encryption_method" />
                <Spinner
                    android:id="@+id/profile_encryption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:entries="@array/easyss_encryption_list" />

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_proxy_rule" />
                <Spinner
                    android:id="@+id/profile_proxy_rule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:entries="@array/easyss_proxyrule_list"
                    android:entryValues="@array/easyss_proxyrule_list_value" />

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_outbound_protocol" />
                <Spinner
                    android:id="@+id/profile_outbound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:entries="@array/easyss_outbound_list"
                    android:entryValues="@array/easyss_outbound_list_value" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section: Advanced -->
        <com.google.android.material.card.MaterialCardView
            style="@style/mCard"
            android:layout_marginTop="10dp">

            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/section_advanced" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/hint_sni">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/profile_server_name_indication"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/hint_custom_ca">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/profile_custom_ca"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:minLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section: Routing Rules -->
        <com.google.android.material.card.MaterialCardView
            style="@style/mCard"
            android:layout_marginTop="10dp">

            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/section_routing_rules" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/hint_direct_domains">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/profile_direct_file"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:minLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/hint_proxy_domains">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/profile_proxy_file"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:minLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section: Options -->
        <com.google.android.material.card.MaterialCardView
            style="@style/mCard"
            android:layout_marginTop="10dp">

            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/section_options" />

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_log_level" />
                <Spinner
                    android:id="@+id/profile_log_level"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:entries="@array/easyss_loglevel_list"
                    android:entryValues="@array/easyss_loglevel_list_value" />

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_enable_quic" />
                <Spinner
                    android:id="@+id/profile_enable_quic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:entries="@array/easyss_enable_quic_list"
                    android:entryValues="@array/easyss_enable_quic_list_value" />

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_ipv6_rule" />
                <Spinner
                    android:id="@+id/profile_ipv6_rule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:entries="@array/easyss_ipv6_rule_list"
                    android:entryValues="@array/easyss_ipv6_rule_value" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_profile_button"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/button_save"
            android:textSize="15sp"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete_profile_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/button_delete"
            android:textSize="15sp"
            android:visibility="gone"
            app:cornerRadius="16dp"
            app:strokeColor="?attr/colorError"
            android:textColor="?attr/colorError"
            tools:visibility="visible" />

    </LinearLayout>
</ScrollView>
