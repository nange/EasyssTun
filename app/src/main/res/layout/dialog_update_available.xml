<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/update_dialog_version"
        style="@style/CardTitle" />

    <TextView
        android:id="@+id/update_dialog_notes"
        style="@style/CardSummary"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:maxLines="8" />

    <TextView
        android:id="@+id/update_dialog_notes_link"
        style="@style/CardSummary"
        android:layout_marginTop="8dp"
        android:text="@string/update_dialog_view_notes"
        android:textColor="?attr/colorPrimary" />

    <TextView
        android:id="@+id/update_dialog_warning"
        style="@style/CardSummary"
        android:layout_marginTop="12dp"
        android:text="@string/update_dialog_warning" />

</LinearLayout>
