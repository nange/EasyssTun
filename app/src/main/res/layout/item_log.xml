<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="4dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Row 1: timestamp + level + source -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/logTimestampTextView"
            android:textSize="12sp"
            android:background="@color/app_color"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:maxLines="1"
            tools:text="07-19 19:08:48.135" />

        <TextView
            android:id="@+id/logLevelTextView"
            android:textSize="12sp"
            android:background="@color/log_level_bg"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:layout_marginStart="4dp"
            android:maxLines="1"
            tools:text="INFO" />

        <TextView
            android:id="@+id/logSourceTextView"
            android:textSize="12sp"
            android:background="@color/teal_700"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:layout_marginStart="4dp"
            android:maxLines="1"
            tools:text="proxy/udp.go:285" />
    </LinearLayout>

    <!-- Row 2: message, wraps and selectable -->
    <TextView
        android:id="@+id/logMessageTextView"
        android:textIsSelectable="true"
        android:textSize="12sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        tools:text="[UDP_PROXY] target=185.125.190.58:123" />

</LinearLayout>
