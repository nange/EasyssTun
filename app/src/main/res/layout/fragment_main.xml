<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="14dp"
    android:layout_marginRight="14dp"
    android:layout_marginTop="0dp"
    android:layout_marginBottom="14dp"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/service_card"
        style="@style/mCard">

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/service_icon"
                    style="@style/CardIcon"
                    android:src="@drawable/ic_launcher_foreground_big"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:duplicateParentState="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/service_title"
                        style="@style/CardTitle"
                        android:text="@string/service_running" />

                    <Spinner
                        android:id="@+id/server_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/service_setting"
                    style="@style/CardButton"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    android:backgroundTint="@color/button_enable"
                    android:text="@string/easyss_configure"
                    app:icon="@drawable/ic_settings_outline_24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/service_button"
                    style="@style/CardButton"
                    android:layout_marginTop="12dp"
                    android:text="@string/service_enable"
                    app:icon="@drawable/ic_outline_play_arrow_24" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/mCard"
        android:layout_marginTop="10dp">

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/applist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@android:id/icon"
                    style="@style/CardIcon"
                    android:src="@drawable/playlist_remove_24px"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:duplicateParentState="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text1"
                        style="@style/CardTitle"
                        android:text="@string/skipped_apps_title" />

                    <TextView
                        android:id="@android:id/text2"
                        style="@style/CardSummary"
                        android:text="@string/choose_app_to_bypass" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/route_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layoutDirection="rtl"
                android:text="@string/route_desc"
                android:textAlignment="viewEnd" />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/stats_card"
        style="@style/mCard"
        android:layout_marginTop="10dp">

        <LinearLayout
            style="@style/Card"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:id="@+id/stats_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    style="@style/CardIcon"
                    android:src="@drawable/ic_outline_info_24"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="20dp"
                    style="@style/CardTitle"
                    android:text="@string/stats_title" />

                <ImageView
                    android:id="@+id/stats_header_arrow"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/expand_arrow_24dp"
                    android:contentDescription="@null"
                    app:tint="@color/teal_700" />
            </LinearLayout>

            <!-- Stats grid: 4 columns, label-on-top -->
            <LinearLayout
                android:id="@+id/stats_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

                <!-- Row 1: always visible — RTT (hero) | DL Speed | UL Speed | TCP Conns -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Latency first, slightly emphasized -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView
                            style="@style/StatsLabel"
                            android:text="@string/stats_rtt_label" />

                        <TextView
                            android:id="@+id/stats_avg_rtt_ms"
                            style="@style/StatsValueHero"
                            android:text="@string/stats_loading" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView
                            style="@style/StatsLabel"
                            android:text="@string/stats_dl_label" />

                        <TextView
                            android:id="@+id/stats_download_speed"
                            style="@style/StatsValue"
                            android:text="" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView
                            style="@style/StatsLabel"
                            android:text="@string/stats_ul_label" />

                        <TextView
                            android:id="@+id/stats_upload_speed"
                            style="@style/StatsValue"
                            android:text="" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView
                            style="@style/StatsLabel"
                            android:text="@string/stats_conns_label" />

                        <TextView
                            android:id="@+id/stats_conns"
                            style="@style/StatsValue"
                            android:text="" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Expandable section: hidden by default -->
                <LinearLayout
                    android:id="@+id/stats_expandable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Row 2: Peak DL | Peak UL | Sent | Received -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <TextView
                                style="@style/StatsLabel"
                                android:text="@string/stats_peak_dl_label" />

                            <TextView
                                android:id="@+id/stats_peak_download_speed"
                                style="@style/StatsValue"
                                android:text="" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <TextView
                                style="@style/StatsLabel"
                                android:text="@string/stats_peak_ul_label" />

                            <TextView
                                android:id="@+id/stats_peak_upload_speed"
                                style="@style/StatsValue"
                                android:text="" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <TextView
                                style="@style/StatsLabel"
                                android:text="@string/stats_sent_label" />

                            <TextView
                                android:id="@+id/stats_bytes_sent"
                                style="@style/StatsValue"
                                android:text="" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <TextView
                                style="@style/StatsLabel"
                                android:text="@string/stats_recv_label" />

                            <TextView
                                android:id="@+id/stats_bytes_recv"
                                style="@style/StatsValue"
                                android:text="" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Row 3: Priority Conns | Bulk Conns | Priority Active | Bulk Active -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <TextView
                                style="@style/StatsLabel"
                                android:text="@string/stats_priority_conns_label" />

                            <TextView
                                android:id="@+id/stats_priority_conns"
                                style="@style/StatsValue"
                                android:text="" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <TextView
                                style="@style/StatsLabel"
                                android:text="@string/stats_bulk_conns_label" />

                            <TextView
                                android:id="@+id/stats_bulk_conns"
                                style="@style/StatsValue"
                                android:text="" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <TextView
                                style="@style/StatsLabel"
                                android:text="@string/stats_priority_active_label" />

                            <TextView
                                android:id="@+id/stats_priority_active_streams"
                                style="@style/StatsValue"
                                android:text="" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <TextView
                                style="@style/StatsLabel"
                                android:text="@string/stats_bulk_active_label" />

                            <TextView
                                android:id="@+id/stats_bulk_active_streams"
                                style="@style/StatsValue"
                                android:text="" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Row 4: Active | Uptime (span 2) | — -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <TextView
                                style="@style/StatsLabel"
                                android:text="@string/stats_active_label" />

                            <TextView
                                android:id="@+id/stats_active_streams"
                                style="@style/StatsValue"
                                android:text="" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <TextView
                                style="@style/StatsLabel"
                                android:text="@string/stats_uptime_label" />

                            <TextView
                                android:id="@+id/stats_uptime"
                                style="@style/StatsValue"
                                android:text="" />
                        </LinearLayout>

                        <!-- Placeholder cell for alignment -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            tools:ignore="UselessLeaf" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Version info -->
            <TextView
                android:id="@+id/version_placeholder"
                style="@style/VersionInfo"
                android:layout_marginTop="16dp"/>
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>