<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="14dp"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/service_card"
        style="@style/mCard">

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/service_icon"
                    style="@style/CardIcon"
                    android:src="@drawable/ic_launcher_foreground_big"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:duplicateParentState="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/service_title"
                        style="@style/CardTitle"
                        android:text="@string/service_running" />

                    <Spinner
                        android:id="@+id/server_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/service_summary"
                        style="@style/CardSummary"
                        android:text="@string/easyss_need_config" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/service_setting"
                    style="@style/CardButton"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    android:backgroundTint="@color/button_enable"
                    android:text="@string/easyss_configure"
                    app:icon="@drawable/ic_settings_outline_24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/service_button"
                    style="@style/CardButton"
                    android:layout_marginTop="12dp"
                    android:text="@string/service_enable"
                    app:icon="@drawable/ic_outline_play_arrow_24" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/mCard"
        android:layout_marginTop="10dp">

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/applist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@android:id/icon"
                    style="@style/CardIcon"
                    android:src="@drawable/playlist_remove_24px"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:duplicateParentState="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text1"
                        style="@style/CardTitle"
                        android:text="@string/skipped_apps_title" />

                    <TextView
                        android:id="@android:id/text2"
                        style="@style/CardSummary"
                        android:text="@string/choose_app_to_bypass" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/route_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layoutDirection="rtl"
                android:text="@string/route_desc"
                android:textAlignment="viewEnd" />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/stats_card"
        style="@style/mCard"
        android:layout_marginTop="10dp">

        <LinearLayout
            style="@style/Card"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    style="@style/CardIcon"
                    android:src="@drawable/ic_outline_info_24"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    style="@style/CardTitle"
                    android:text="@string/stats_title" />
            </LinearLayout>

            <!-- Stats grid: 2 columns -->
            <LinearLayout
                android:id="@+id/stats_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/stats_avg_rtt_ms"
                        style="@style/CardSummary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/stats_loading" />

                    <TextView
                        android:id="@+id/stats_conns"
                        style="@style/CardSummary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/stats_bytes_sent"
                        style="@style/CardSummary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="" />

                    <TextView
                        android:id="@+id/stats_bytes_recv"
                        style="@style/CardSummary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/stats_priority_conns"
                        style="@style/CardSummary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="" />

                    <TextView
                        android:id="@+id/stats_bulk_conns"
                        style="@style/CardSummary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/stats_priority_active_streams"
                        style="@style/CardSummary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="" />

                    <TextView
                        android:id="@+id/stats_bulk_active_streams"
                        style="@style/CardSummary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/stats_uptime"
                        style="@style/CardSummary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="" />

                    <TextView
                        android:id="@+id/stats_active_streams"
                        style="@style/CardSummary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/stats_download_speed"
                        style="@style/CardSummary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="" />

                    <TextView
                        android:id="@+id/stats_upload_speed"
                        style="@style/CardSummary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/stats_peak_download_speed"
                        style="@style/CardSummary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="" />

                    <TextView
                        android:id="@+id/stats_peak_upload_speed"
                        style="@style/CardSummary"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="" />

                </LinearLayout>

            </LinearLayout>

            <!-- Version info -->
            <TextView
                android:id="@+id/version_placeholder"
                style="@style/CardSummary"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>